{
  // This file is not used in compilation. It is here just for a nice editor experience.
  // Deliberately not extending @docusaurus/tsconfig: it still sets "baseUrl", which
  // TypeScript 7 removed, so extending it fails with TS5102 and no local override can
  // suppress it. Its compilerOptions are inlined below, with "paths" resolved relative
  // to this file instead. Re-extend once Docusaurus ships a baseUrl-free tsconfig.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build"]
}
